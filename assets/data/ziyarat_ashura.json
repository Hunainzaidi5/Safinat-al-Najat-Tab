{
  "title": "Ziyarat e Ashura - Structural Time Sync",
  "totalDuration": 687.0,
  "paragraphs": [
    {
      "id": 1,
      "startTime": 1.0,
      "endTime": 10.0,
      "arabic": "بسم الله الرحمن الرحيم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 2,
      "startTime": 10.0,
      "endTime": 15.0,
      "arabic": "السلام عليك يا أبا عبد الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 3,
      "startTime": 15.0,
      "endTime": 20.0,
      "arabic": "السلام عليك يا ابن رسول الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 4,
      "startTime": 20.0,
      "endTime": 26.0,
      "arabic": "السلام عليك يا خيرة الله وابن خيارته",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 5,
      "startTime": 26.0,
      "endTime": 31.0,
      "arabic": "السلام عليك يا ابن أمير المؤمنين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 6,
      "startTime": 31.0,
      "endTime": 36.0,
      "arabic": "وابن سيد الوسين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 7,
      "startTime": 36.0,
      "endTime": 40.0,
      "arabic": "السلام عليك يا ابن فاطمة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 8,
      "startTime": 40.0,
      "endTime": 44.0,
      "arabic": "سيدة نساء العالمين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 9,
      "startTime": 44.0,
      "endTime": 48.0,
      "arabic": "السلام عليك يا ثار الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 10,
      "startTime": 48.0,
      "endTime": 53.0,
      "arabic": "وابن ثاره والوتر الموتور",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 11,
      "startTime": 53.0,
      "endTime": 61.0,
      "arabic": "السلام عليك وعلى الأرواح التي حلت بفنائك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 12,
      "startTime": 61.0,
      "endTime": 68.0,
      "arabic": "عليكم مني جميعا سلام الله أبدا ما بقيت",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 13,
      "startTime": 68.0,
      "endTime": 71.0,
      "arabic": "وبقي الليل والنهار",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 14,
      "startTime": 71.0,
      "endTime": 74.0,
      "arabic": "يا أبا عبد الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 15,
      "startTime": 74.0,
      "endTime": 82.0,
      "arabic": "لقد عظمت الرزية وجلة عظمة المصيبة بك علينا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 16,
      "startTime": 82.0,
      "endTime": 86.0,
      "arabic": "وعلى جميع أهل الإسلام",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 17,
      "startTime": 86.0,
      "endTime": 91.0,
      "arabic": "وجلة عظمت مصيبتك في السماوات",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 18,
      "startTime": 91.0,
      "endTime": 95.0,
      "arabic": "على جميع أهل السماوات",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 19,
      "startTime": 95.0,
      "endTime": 104.0,
      "arabic": "فلعن الله أمة أسست أساس الظلم والجول عليكم أهل البيت",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 20,
      "startTime": 104.0,
      "endTime": 109.0,
      "arabic": "ولعن الله أمة دفعتكم عن مقامكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 21,
      "startTime": 109.0,
      "endTime": 116.0,
      "arabic": "وأزالتكم عن مراتبكم التي رتبكم الله فيها",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 22,
      "startTime": 116.0,
      "endTime": 121.0,
      "arabic": "ولعن الله أمة قتلتكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 23,
      "startTime": 121.0,
      "endTime": 128.0,
      "arabic": "ولعن الله الممهدين لهم بالتمكين من قتالكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 24,
      "startTime": 128.0,
      "endTime": 133.0,
      "arabic": "بريت إلى الله وإليكم منهم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 25,
      "startTime": 133.0,
      "endTime": 139.0,
      "arabic": "ومن أشياعهم وأتباعهم وأونيائهم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 26,
      "startTime": 139.0,
      "endTime": 142.0,
      "arabic": "يا أبا عبد الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 27,
      "startTime": 142.0,
      "endTime": 146.0,
      "arabic": "إني سلم لمن سالمكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 28,
      "startTime": 146.0,
      "endTime": 149.0,
      "arabic": "وحرب لمن حاربكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 29,
      "startTime": 149.0,
      "endTime": 152.0,
      "arabic": "إلى يوم القيامة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 30,
      "startTime": 152.0,
      "endTime": 157.0,
      "arabic": "ولعن الله آل زياد وآل مرغان",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 31,
      "startTime": 157.0,
      "endTime": 162.0,
      "arabic": "ولعن الله بني أمية قاطبة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 32,
      "startTime": 162.0,
      "endTime": 165.0,
      "arabic": "ولعن الله ابن مرجونة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 33,
      "startTime": 165.0,
      "endTime": 169.0,
      "arabic": "ولعن الله أمر بن سغر",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 34,
      "startTime": 169.0,
      "endTime": 172.0,
      "arabic": "ولعن الله شمرة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 35,
      "startTime": 172.0,
      "endTime": 183.0,
      "arabic": "ولعن الله أمة أسرجت وألجمت وتنقبت لقتالك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 36,
      "startTime": 183.0,
      "endTime": 187.0,
      "arabic": "بأبي أنت وأمي",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 37,
      "startTime": 187.0,
      "endTime": 190.0,
      "arabic": "لقد عظم مصاحبك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 38,
      "startTime": 190.0,
      "endTime": 195.0,
      "arabic": "فأسأل الله الذي أكرم مقامك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 39,
      "startTime": 195.0,
      "endTime": 200.0,
      "arabic": "وأكرمني بك أن يرزقني طلب ثارك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 40,
      "startTime": 200.0,
      "endTime": 207.0,
      "arabic": "مع إمام منصور من أهل بيت محمد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 41,
      "startTime": 207.0,
      "endTime": 210.0,
      "arabic": "صلى الله عليه وعليه",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 42,
      "startTime": 210.0,
      "endTime": 217.0,
      "arabic": "اللهم اجعلني عندك وجيها بالحسين عليه السلام",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 43,
      "startTime": 218.0,
      "endTime": 221.0,
      "arabic": "في الدنيا والآخرة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 44,
      "startTime": 221.0,
      "endTime": 224.0,
      "arabic": "يا أبا عبد الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 45,
      "startTime": 224.0,
      "endTime": 227.0,
      "arabic": "إني أتغرب إلى الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 46,
      "startTime": 227.0,
      "endTime": 229.0,
      "arabic": "وإلى رسوله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 47,
      "startTime": 229.0,
      "endTime": 232.0,
      "arabic": "وإلى أمير المؤمنين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 48,
      "startTime": 232.0,
      "endTime": 234.0,
      "arabic": "وإلى فاطمة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 49,
      "startTime": 234.0,
      "endTime": 236.0,
      "arabic": "وإلى الحسن",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 50,
      "startTime": 236.0,
      "endTime": 239.0,
      "arabic": "وإليك بمضالاتك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 51,
      "startTime": 239.0,
      "endTime": 242.0,
      "arabic": "وبالبراءة ممن قاتلك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 52,
      "startTime": 242.0,
      "endTime": 245.0,
      "arabic": "ونسب لك الحرب",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 53,
      "startTime": 245.0,
      "endTime": 252.0,
      "arabic": "وبالبراءة ممن أسس أساس الظلم والجور عليكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 54,
      "startTime": 252.0,
      "endTime": 257.0,
      "arabic": "وأبرأ إلى الله وإلى رسوله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 55,
      "startTime": 257.0,
      "endTime": 260.0,
      "arabic": "ممن أسس أساس ذلك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 56,
      "startTime": 260.0,
      "endTime": 264.0,
      "arabic": "وبنى عليه بنيانا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 57,
      "startTime": 264.0,
      "endTime": 269.0,
      "arabic": "وجرى في ظلمه وجوره عليكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 58,
      "startTime": 269.0,
      "endTime": 272.0,
      "arabic": "وعلى أشيائكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 59,
      "startTime": 272.0,
      "endTime": 277.0,
      "arabic": "بريت إلى الله وإليكم منهم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 60,
      "startTime": 277.0,
      "endTime": 283.0,
      "arabic": "وتغرب إلى الله ثم إليكم بمضالاتكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 61,
      "startTime": 283.0,
      "endTime": 286.0,
      "arabic": "ومضالات وليكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 62,
      "startTime": 286.0,
      "endTime": 290.0,
      "arabic": "وبالبراءة من أعدائكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 63,
      "startTime": 290.0,
      "endTime": 293.0,
      "arabic": "والناصبين لكم الحرب",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 64,
      "startTime": 293.0,
      "endTime": 299.0,
      "arabic": "وبالبراءة من أشيائهم وأتباعهم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 65,
      "startTime": 299.0,
      "endTime": 303.0,
      "arabic": "أني سلم لمن صالمكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 66,
      "startTime": 303.0,
      "endTime": 307.0,
      "arabic": "وحرب لمن حاربكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 67,
      "startTime": 307.0,
      "endTime": 310.0,
      "arabic": "وودي لمن ضالاكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 68,
      "startTime": 310.0,
      "endTime": 314.0,
      "arabic": "وعدو لمن عداكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 69,
      "startTime": 314.0,
      "endTime": 320.0,
      "arabic": "فأسأل الله الذي يكرمني بمعرفتكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 70,
      "startTime": 320.0,
      "endTime": 323.0,
      "arabic": "ومعرفة أوليائكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 71,
      "startTime": 323.0,
      "endTime": 327.0,
      "arabic": "ورزقني البراءة من أعدائكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 72,
      "startTime": 327.0,
      "endTime": 332.0,
      "arabic": "أن يجعلني معكم في الدنيا والآخرة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 73,
      "startTime": 332.0,
      "endTime": 339.0,
      "arabic": "وأن يثبتني عندكم غدم صدق في الدنيا والآخرة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 74,
      "startTime": 339.0,
      "endTime": 344.0,
      "arabic": "وأسأله أن يبلغني المقام المحمود",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 75,
      "startTime": 344.0,
      "endTime": 347.0,
      "arabic": "لكم عند الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 76,
      "startTime": 347.0,
      "endTime": 350.0,
      "arabic": "وأن يرزقني طلب ثاري",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 77,
      "startTime": 350.0,
      "endTime": 356.0,
      "arabic": "مع إمام هدى ظاهر ناطق بالحق منكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 78,
      "startTime": 356.0,
      "endTime": 360.0,
      "arabic": "وأسأل الله بحقكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 79,
      "startTime": 360.0,
      "endTime": 363.0,
      "arabic": "وبالشأن الذي لكم عنده",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 80,
      "startTime": 363.0,
      "endTime": 367.0,
      "arabic": "أن يعطيني بمصابيبكم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 81,
      "startTime": 367.0,
      "endTime": 372.0,
      "arabic": "أفضل ما يعطي مصابا بمصيبة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 82,
      "startTime": 372.0,
      "endTime": 376.0,
      "arabic": "مصيبة ما عظمها",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 83,
      "startTime": 376.0,
      "endTime": 380.0,
      "arabic": "وعظم رزيتها في النسل",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 84,
      "startTime": 380.0,
      "endTime": 384.0,
      "arabic": "وفي جميع السماوات والأرض",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 85,
      "startTime": 385.0,
      "endTime": 390.0,
      "arabic": "اللهم اجعلني في مقامي هذا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 86,
      "startTime": 390.0,
      "endTime": 393.0,
      "arabic": "ممن تناله منك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 87,
      "startTime": 393.0,
      "endTime": 397.0,
      "arabic": "صلوات ورحمة ومغفرة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 88,
      "startTime": 397.0,
      "endTime": 402.0,
      "arabic": "اللهم اجعل محياة محياة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 89,
      "startTime": 402.0,
      "endTime": 405.0,
      "arabic": "محمد والمحمد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 90,
      "startTime": 405.0,
      "endTime": 411.0,
      "arabic": "ومماتي ممات محمد والمحمد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 91,
      "startTime": 411.0,
      "endTime": 415.0,
      "arabic": "اللهم إن هذا يوم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 92,
      "startTime": 415.0,
      "endTime": 419.0,
      "arabic": "تبركت به بنو مهيا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 93,
      "startTime": 419.0,
      "endTime": 423.0,
      "arabic": "وابن آكلة الأكبر",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 94,
      "startTime": 423.0,
      "endTime": 427.0,
      "arabic": "اللعين ابن اللعين على لسانك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 95,
      "startTime": 427.0,
      "endTime": 429.0,
      "arabic": "ولسان نبيك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 96,
      "startTime": 429.0,
      "endTime": 433.0,
      "arabic": "صلى الله عليه وآله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 97,
      "startTime": 433.0,
      "endTime": 439.0,
      "arabic": "في كل موطن وموقف وقف فيه نبيك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 98,
      "startTime": 439.0,
      "endTime": 443.0,
      "arabic": "صلى الله عليه وآله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 99,
      "startTime": 443.0,
      "endTime": 448.0,
      "arabic": "اللهم لعن ابا سفيان ومعاوذه",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 100,
      "startTime": 448.0,
      "endTime": 451.0,
      "arabic": "ويزيد ابن معاوذه",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 101,
      "startTime": 451.0,
      "endTime": 456.0,
      "arabic": "عليهم منك اللعنة أبدا وابدي",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 102,
      "startTime": 456.0,
      "endTime": 461.0,
      "arabic": "وهذا يوم فرحت به آل زياد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 103,
      "startTime": 461.0,
      "endTime": 463.0,
      "arabic": "وآل مرهاد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 104,
      "startTime": 463.0,
      "endTime": 466.0,
      "arabic": "بقتلهم الحسين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 105,
      "startTime": 466.0,
      "endTime": 469.0,
      "arabic": "صلى الله عليه",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 106,
      "startTime": 469.0,
      "endTime": 476.0,
      "arabic": "اللهم فضعف عليهم اللعنة منك والعذاب الأليم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 107,
      "startTime": 476.0,
      "endTime": 481.0,
      "arabic": "اللهم إني أتقرب إليك في هذا اليوم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 108,
      "startTime": 481.0,
      "endTime": 487.0,
      "arabic": "وفي موقفي هذا وأيام حياتي",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 109,
      "startTime": 487.0,
      "endTime": 492.0,
      "arabic": "بالبراءة منهم واللعنة عليهم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 110,
      "startTime": 492.0,
      "endTime": 498.0,
      "arabic": "وبالمضالات لنبيك وآل نبيك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 111,
      "startTime": 498.0,
      "endTime": 502.0,
      "arabic": "عليهم وعليهم السلام",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 112,
      "startTime": 504.0,
      "endTime": 509.0,
      "arabic": "اللهم لعن أول ظالم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 113,
      "startTime": 509.0,
      "endTime": 514.0,
      "arabic": "ظلم حق محمد وآل محمد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 114,
      "startTime": 514.0,
      "endTime": 519.0,
      "arabic": "وآخر تابع له وعلى ذلك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 115,
      "startTime": 519.0,
      "endTime": 525.0,
      "arabic": "اللهم لعن العصابة التي جاهدت الحسن",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 116,
      "startTime": 525.0,
      "endTime": 532.0,
      "arabic": "وشايعت وبايعت وتابعت على قتله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 117,
      "startTime": 532.0,
      "endTime": 538.0,
      "arabic": "اللهم لعنهم جميعا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 118,
      "startTime": 541.0,
      "endTime": 548.0,
      "arabic": "السلام عليك يا أبا عبد الله",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 119,
      "startTime": 549.0,
      "endTime": 556.0,
      "arabic": "وعلى الأرواح التي حلت بثنائك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 120,
      "startTime": 556.0,
      "endTime": 562.0,
      "arabic": "عليك مني سلام الله أبدا ما بقيت",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 121,
      "startTime": 562.0,
      "endTime": 566.0,
      "arabic": "وبقي الليل والنهار",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 122,
      "startTime": 566.0,
      "endTime": 571.0,
      "arabic": "ولا جعلهم آخر العهد مني",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 123,
      "startTime": 571.0,
      "endTime": 578.0,
      "arabic": "لزيارتك",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 124,
      "startTime": 579.0,
      "endTime": 585.0,
      "arabic": "السلام على المحسن",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 125,
      "startTime": 585.0,
      "endTime": 591.0,
      "arabic": "وعلى علي بن المحسن",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 126,
      "startTime": 591.0,
      "endTime": 597.0,
      "arabic": "وعلى أولاد المحسن",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 127,
      "startTime": 597.0,
      "endTime": 603.0,
      "arabic": "وعلى أصحاب المحسن",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 128,
      "startTime": 604.0,
      "endTime": 610.0,
      "arabic": "اللهم خص أنت أول ظالم باللعن مني",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 129,
      "startTime": 610.0,
      "endTime": 613.0,
      "arabic": "وابدا به أولا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 130,
      "startTime": 613.0,
      "endTime": 618.0,
      "arabic": "ثم لعن الثاني والثالث والرابع",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 131,
      "startTime": 618.0,
      "endTime": 622.0,
      "arabic": "اللهم لعن يزيد خامسا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 132,
      "startTime": 622.0,
      "endTime": 626.0,
      "arabic": "ولعن عبيد الله بن زياد",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 133,
      "startTime": 626.0,
      "endTime": 632.0,
      "arabic": "وابن مرجانا وعمر بن سعد وشمرا",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 134,
      "startTime": 632.0,
      "endTime": 638.0,
      "arabic": "وعلى أبي سفيان وعلى زياد وعلى مردان",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 135,
      "startTime": 638.0,
      "endTime": 643.0,
      "arabic": "إلى يوم القيامة",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 136,
      "startTime": 643.0,
      "endTime": 648.0,
      "arabic": "اللهم لك الحمد وحمد الشاكرين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 137,
      "startTime": 648.0,
      "endTime": 652.0,
      "arabic": "لك على مصابهم",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 138,
      "startTime": 652.0,
      "endTime": 659.0,
      "arabic": "الحمد لله على عظيم رتيتي",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 139,
      "startTime": 659.0,
      "endTime": 664.0,
      "arabic": "اللهم ارزقني شفاعة الحسين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 140,
      "startTime": 664.0,
      "endTime": 667.0,
      "arabic": "يوم الغرود",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 141,
      "startTime": 667.0,
      "endTime": 673.0,
      "arabic": "وثبتني قدم صدق عندك مع الحسين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 142,
      "startTime": 673.0,
      "endTime": 677.0,
      "arabic": "وأصحاب الحسين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 143,
      "startTime": 677.0,
      "endTime": 683.0,
      "arabic": "الذين بذلوا هجهم دون الحسين",
      "transliteration": "",
      "translation": ""
    },
    {
      "id": 144,
      "startTime": 683.0,
      "endTime": 687.0,
      "arabic": "عليه الصلاة",
      "transliteration": "",
      "translation": ""
    }
  ]
}